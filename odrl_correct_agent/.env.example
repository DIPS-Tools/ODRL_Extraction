# AI model used for reconciliation and included in corrected dataset filenames.
MODEL_NAME=gpt-5.6-luna

# OpenAI or OpenAI-compatible endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: set both consistently when the account uses explicit scoping.
# OPENAI_ORG_ID=org-...
# OPENAI_PROJECT_ID=proj_...

# ODRL extraction service used as a second source of evidence.
ODRL_EXTRACTION_ENDPOINT=http://127.0.0.1:5001/odrl_generation
# Optional audit label for the trained model served by the endpoint.
ODRL_EXTRACTION_MODEL_NAME=contract-bert-lstm-crf_ep20_bz16_max_len400_lr5e-05_ltBIO_num_layers1_best_f1.pth
ODRL_EXTRACTION_TIMEOUT_SECONDS=30
ODRL_EXTRACTION_MAX_RETRIES=2

# Optional. Omit for models that only accept their default temperature.
# ODRL_CORRECTION_TEMPERATURE=0
# Medium reasoning preserves correction quality while Batch API halves the
# standard request price. The cap protects cost; truncated records are rejected
# by Batch finalization instead of silently entering the training dataset.
ODRL_CORRECTION_REASONING_EFFORT=medium
ODRL_CORRECTION_MAX_OUTPUT_TOKENS=128000
ODRL_CORRECTION_JSON_MODE=true

# Command-line progress logging: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
ODRL_CORRECTION_LOG_LEVEL=INFO

# Resumable Batch watcher settings. The 26-hour local timeout leaves a small
# buffer beyond OpenAI's supported 24-hour Batch completion window. Timing out
# locally never cancels the remote job; resume with the saved manifest.
ODRL_BATCH_POLL_SECONDS=300
ODRL_BATCH_WATCH_TIMEOUT_HOURS=26
ODRL_BATCH_MAX_CONSECUTIVE_ERRORS=12
# Verify the uploaded JSONL is visible and processed before creating a Batch.
ODRL_BATCH_FILE_READY_TIMEOUT_SECONDS=180
ODRL_BATCH_FILE_READY_POLL_SECONDS=2
